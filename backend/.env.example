PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@DB_HOST:3306/DB_NAME"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-a-different-random-secret-at-least-32-characters"
CORS_ORIGIN="http://localhost:5173"
SMTP_HOST="mail.medinovel.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="info@medinovel.com"
SMTP_PASS=""
MAIL_FROM="MediNovel <info@medinovel.com>"
CONTACT_NOTIFY_EMAILS="info@medinovel.com"
PRISMA_CLIENT_ENGINE_TYPE="library"
PRISMA_TOKIO_WORKER_THREADS=2
SEED_SUPER_ADMIN_PASSWORD="replace-with-a-strong-seed-password"
SEED_REAL_SUPER_ADMIN_PASSWORD="replace-with-a-strong-seed-password"
SEED_DOCTOR_PASSWORD="replace-with-a-strong-seed-password"
SEED_RECEPTIONIST_PASSWORD="replace-with-a-strong-seed-password"
TEST_SUPER_ADMIN_PASSWORD="replace-with-the-seeded-super-admin-password"
TEST_DOCTOR_PASSWORD="replace-with-the-seeded-doctor-password"
TEST_RECEPTIONIST_PASSWORD="replace-with-the-seeded-receptionist-password"
TEST_INVALID_PASSWORD="replace-with-a-known-invalid-password"
